################################################################################
#####                      C O N F I G U R A T I O N                      ######
################################################################################
CACHE_DIR = os.path.expanduser("~/.cache/rofi-web-search")
CACHE_FILE = os.path.join(CACHE_DIR, "user_agent.txt")
CONFIG_DIR = os.path.expanduser("~/.config/rofi-web-search")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")


################################################################################
def load_config():
    _config = DEFAULT_CONFIG.copy()
    try:
        with open(CONFIG_FILE, "r") as f:
            user_config = json.load(f)
            validate_config(user_config)
            _config.update(user_config)  # Overwrite defaults with user settings
    except (FileNotFoundError, json.JSONDecodeError):
        pass  # Silently fall back to the defaults
    return _config


CONFIG = load_config()

# You can add your own browsers here
# As long as their --version output is similar to the existing ones
# The program should work well
BINARY_NAMES = {
    "chrome": "google-chrome-stable",
    "firefox": "firefox",
    "chromium": "chromium-browser",
    "brave": "brave-browser",
    "brave-beta": "brave-beta",
    "vivaldi": "vivaldi-stable",
    "lynx": CONFIG["TERMINAL"] + CONFIG["TERMINAL_ARG"] + "lynx",
}
SEARCH_ENGINE_NAMES = {
    "google": "Google",
    "duckduckgo": "DuckDuckGo",
    "brave-search": "Brave Search",
    "startpage": "Startpage",
    "youtube": "YouTube",
    "github": "GitHub",
    "reddit": "Reddit",
}
SEARCH_URLS = {
    "google": "https://www.google.com/search?q=",
    "duckduckgo": "https://duckduckgo.com/?q=",
    "brave-search": "https://search.brave.com/search?q=",
    "startpage": "https://www.startpage.com/do/search?q=",
    "youtube": "https://www.youtube.com/results?search_query=",
    "github": "https://github.com/search?q=",
    "reddit": "https://www.reddit.com/search/?q=",
}
SUGGESTION_URLS = {
    "google": "https://www.google.com/complete/search?",
    "duckduckgo": "https://duckduckgo.com/ac/?",
    "startpage": "https://www.startpage.com/suggestions?q=",
}

SUGGESTIONS_INCOMPATIBLE = ["brave-search", "github", "youtube", "reddit"]

# Linux desktop User-Agent templates
TEMPLATES = {
    "firefox": "Mozilla/5.0 (X11; Linux x86_64; rv:{ver}) Gecko/20100101 Firefox/{ver}",
    "chrome": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{ver} Safari/537.36",
    "chromium": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{ver} Safari/537.36",
    "brave": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{ver} Safari/537.36",
}

FALLBACK_UA = "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0"

DEFAULT_CONFIG = {
    "SEARCH_ENGINE": "google",
    "BROWSER": "firefox",
    "TERMINAL": "gnome-terminal",
    "TERMINAL_ARG": "--",
}


def cleanhtml(txt):
    return re.sub(r"<.*?>", "", txt)


def get_binary_version(binary_name: str) -> str | None:
    """Runs <binary> --version and parses out the first semantic version string"""
    bin_path = shutil.which(binary_name)
    if not bin_path:
        return None

    try:
        output = sp.check_output(
            [bin_path, "--version"], stderr=sp.DEVNULL, timeout=1.0, text=True
        )
        match = re.search(r"(\d+(\.\d+)+)", output)
        return match.group(1) if match else None
    except (sp.SubprocessError, OSError):
        return None


def get_cached_user_agent(browser_key: str, binary_name: str) -> str:
    """Returns a valid User_Agent string from cache, updating it if the binary was updated"""
    bin_path = shutil.which(binary_name)

    # if the binary it not found on PATH, fall back immediately
    if not bin_path or not os.path.exists(bin_path):
        return FALLBACK_UA
    os.makedirs(CACHE_DIR, exist_ok=True)
    bin_mtime = os.path.getmtime((bin_path))

    # check if cache exists and is newer than the binary itself
    if os.path.exists(CACHE_FILE):
        cache_mtime = os.path.getmtime(CACHE_FILE)
        if cache_mtime >= bin_mtime:
            try:
                with open(CACHE_FILE, "r", encoding="utf-8") as f:
                    cached_data = f.read().strip()
                    if cached_data:
                        return cached_data
            except OSError:
                pass

    # cache miss or binary was updated by the package manager
    version = get_binary_version(binary_name)
    if not version:
        return FALLBACK_UA
    template = TEMPLATES.get(browser_key, TEMPLATES["firefox"])
    user_agent = template.format(ver=version)

    # write the new cache file
    try:
        with open(CACHE_FILE, "w", encoding="utf-8") as f:
            _ = f.write(user_agent)
    except OSError:
        pass
    return user_agent


def fetch_suggestions(search_string: str, config: dict[str, str]) -> str | list[str]:
    browser_key = config["BROWSER"]
    search_engine = config["SEARCH_ENGINE"]
    binary_name = BINARY_NAMES[browser_key]
    if search_engine in SUGGESTIONS_INCOMPATIBLE:
        return f"Suggestions from {search_engine} are not supported."
    suggestions_url = SUGGESTION_URLS[browser_key]

    user_agent = get_cached_user_agent(browser_key, binary_name)

    if search_engine == "google":
        r = {
            "q": search_string,
            "cp": "11",
            "client": "psy-ab",
            "xssi": "t",
            "gs_ri": "gws-wiz",
            "hl": "en-IT",
            "authuser": "0",
        }
        url = suggestions_url + urllib.parse.urlencode(r)
        headers = {
            "sec-fetch-mode": "cors",
            "dnt": "1",
            "accept-encoding": "gzip",
            "accept-language": "en-US;q=0.9,en;q=0.8",
            "pragma": "no-cache",
            "user-agent": user_agent,
            "accept": "*/*",
            "cache-control": "no-cache",
            "authority": "www.google.com",
            "referer": "https://www.google.com/",
            "sec-fetch-site": "same-origin",
        }
        req = urllib.request.Request(url, headers=headers, method="GET")

        reply_data = gzip.decompress(urllib.request.urlopen(req).read()).split(b"\n")[1]
        reply_data = json.loads(reply_data)
        return [cleanhtml(res[0]).strip() for res in reply_data[0]]
    elif search_engine == "duckduckgo":  # 'duckduckgo'
        if search_string.startswith("!"):
            bang_search = True
            search_string = search_string.lstrip("!")
        else:
            bang_search = False
        r = {
            "q": search_string,
            "callback": "autocompleteCallback",
            "kl": "wt-wt",
            "_": str(int((datetime.datetime.now().timestamp()) * 1000)),
        }
        url = suggestions_url + urllib.parse.urlencode(r)
        if bang_search:
            url = url.replace("?q=", "?q=!")
        headers = {
            "pragma": "no-cache",
            "dnt": "1",
            "accept-encoding": "gzip",
            "accept-language": "en-US;q=0.9,en;q=0.8",
            "user-agent": user_agent,
            "sec-fetch-mode": "no-cors",
            "accept": "*/*",
            "cache-control": "no-cache",
            "authority": "duckduckgo.com",
            "referer": "https://duckduckgo.com/",
            "sec-fetch-site": "same-origin",
        }
        req = urllib.request.Request(url, headers=headers, method="GET")
        reply_data = gzip.decompress(urllib.request.urlopen(req).read()).decode("utf8")
        reply_data = json.loads(
            re.match(r"autocompleteCallback\((.*)\);", reply_data).group(1)
        )
        return [cleanhtml(res["phrase"]).strip() for res in reply_data]
    elif search_engine == "startpage":
        pass


def validate_config(config: dict[str, str]):
    if type(config) is not dict:
        print("Configuration file must be a JSON object", file=sys.stderr)
        sys.exit(1)
    for key in DEFAULT_CONFIG.keys():
        if key not in config:
            print(f"Configuration file is missing {key}", file=sys.stderr)
            sys.exit(1)
    for key in ("SEARCH_ENGINE", "BROWSER"):
        if type(config[key]) is not str:
            print(
                f"Configuration Error: The value of {key} must be a string",
                file=sys.stderr,
            )
    if type(config["TERMINAL"]) is not str:
        print(
            "Configuration Error: The value of TERMINAL must be a string",
            file=sys.stderr,
        )
        sys.exit(1)
    if type(config["TERMINAL_ARG"]) is not str:
        print(
            "Configuration Error: The value of TERMINAL_ARG must be a string",
            file=sys.stderr,
        )
        sys.exit(1)


if __name__ == "__main__":
    config = load_config()
    search_engine = config["SEARCH_ENGINE"]
    search_string = html.unescape((" ".join(sys.argv[1:])).strip())
    browser_key = config["BROWSER"]

    if search_string.endswith("!"):
        search_string = search_string.rstrip("!").strip()
        results = fetch_suggestions(search_string, config)
        if results:
            for r in results:
                print(html.unescape(r))
        else:
            print("!!-- No suggestions found")
    elif search_string == "":
        print(f"!!-- Type something and search it with {search_engine} ")
        print('!!-- Close your search string with "!" to get search suggestions')
    else:
        url = SEARCH_URLS[search_engine] + urllib.parse.quote_plus(search_string)
        _ = sp.Popen(
            [BINARY_NAMES[browser_key], url],
            stdout=sp.DEVNULL,
            stderr=sp.DEVNULL,
            shell=False,
        )
